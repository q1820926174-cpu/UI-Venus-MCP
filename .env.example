# UI-Venus MCP configuration — copy to .env (gitignored) and fill in.
# NEVER commit real keys.

# --- Vision provider (required for vision features) ---
VENUS_BASE_URL=http://<gpu-host>:8300/v1
VENUS_API_KEY=your-api-key-here
VENUS_MODEL=UI-Venus-2-9B-W8A8
# VENUS_TIMEOUT_MS=120000
# VENUS_TEMPERATURE=0
# VENUS_ENABLE_THINKING=false
# VENUS_MIN_PIXELS=3136
# VENUS_MAX_PIXELS=12845056
# VENUS_ALLOW_INSECURE_HTTP=true

# --- Orchestrator ---
# CUMCP_MAX_STEPS=30
# CUMCP_TASK_TIMEOUT_MS=600000
# CUMCP_STEP_TIMEOUT_MS=120000
# CUMCP_MAX_RECOVERIES=5
# CUMCP_MAX_STAGNATION=3

# --- Security policy ---
# CUMCP_CONFIRM_SENSITIVE=true
# CUMCP_SENSITIVE_KEYWORDS=删除,delete,pay,支付,转账,transfer
# CUMCP_ALLOWED_ACTIONS=click,type,scroll
# CUMCP_ALLOWED_APPS=
# CUMCP_BLOCKED_APPS=
# CUMCP_ALLOWED_DEVICES=
# CUMCP_ALLOWED_DOMAINS=
# CUMCP_CONFIRMATION_TIMEOUT_MS=300000

# --- Screenshot pipeline ---
# CUMCP_SCREENSHOT_FORMAT=png
# CUMCP_JPEG_QUALITY=80
# CUMCP_MAX_DIMENSION=2560

# --- Browser adapter ---
# CUMCP_BROWSER_HEADLESS=1
# CUMCP_TEST_ID_ATTR=data-testid
